{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "components/*": ["src/components/*"],
      "context/*": ["src/context/*"],
      "hooks/*": ["src/hooks/*"],
      "theme/*": ["src/theme/*"],
      "styles/*": ["src/styles/*"],
      "plugins/*": ["src/plugins/*"],
      "assets/*": ["src/assets/*"],
      "data": ["src/data.js"],
      "config": ["src/config.js"],
      "lib/*": ["lib/*"]
    }
  },
  "include": ["pages/**/*", "src/**/*", "lib/**/*"]
}
